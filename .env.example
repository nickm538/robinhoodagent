# ======================================================================
# rh-agent environment configuration  —  copy to .env and fill in.
# NEVER commit your real .env (it is gitignored).
# ======================================================================

# --- Market data providers (priority order is configured in config.yaml) ---
# FinancialDatasets.AI  (https://financialdatasets.ai)  — PRIORITY source
FINANCIALDATASETS_API_KEY=

# Mboum  (https://mboum.com / https://docs.mboum.com) — PRIORITY source
# Bearer token, format like "769|xxxxxxxx".
MBOUM_API_KEY=

# Alpha Vantage (https://www.alphavantage.co) — technicals, news sentiment, macro
ALPHAVANTAGE_API_KEY=

# Twelve Data (https://twelvedata.com) — quotes/technicals fallback
TWELVEDATA_API_KEY=

# --- Optional web research (pro-source scores: Zacks / Morningstar / Danelfin / TipRanks) ---
# Exa search (https://exa.ai). If absent, web-research factor is skipped (not faked).
EXA_API_KEY=

# --- AI analyst (the 6th, LLM-in-the-loop voice — Claude) ---
# Anthropic API key. If absent, the AI overlay no-ops and the agent runs pure-quant.
ANTHROPIC_API_KEY=

# --- Robinhood Agentic Trading MCP ---
# Endpoint is fixed by Robinhood. Auth is OAuth: run `rh-agent auth` once, or set a token.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=
ROBINHOOD_MCP_TOKEN_FILE=

# --- Execution (REAL MONEY — Robinhood Agentic account) ---
# live   = place REAL orders (this deployment default)
# paper  = simulate fills on live prices only (set both below to test safely)
EXECUTION_MODE=live
# Required exact string to arm live order placement:
LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY
