# ======================================================================
# rh-agent environment configuration  —  copy to .env and fill in.
# NEVER commit your real .env (it is gitignored).
# ======================================================================

# --- Market data providers (priority order is configured in config.yaml) ---
# FinancialDatasets.AI  (https://financialdatasets.ai)  — PRIMARY source (paid)
FINANCIALDATASETS_API_KEY=
# Optional: requests/sec pacing. Credits are VOLUME; FD also enforces a per-minute
# VELOCITY ceiling per tier — pace under it and 429/Retry-After waves disappear.
# e.g. a 240 req/min tier -> 4. Default 8 (=480/min).
FINANCIALDATASETS_MAX_PER_SEC=8
# Optional: seconds to stand down after an FD 429 (Retry-After header wins when sent).
FINANCIALDATASETS_RATE_LIMIT_COOLDOWN_SECONDS=60

# Mboum  (https://mboum.com / https://docs.mboum.com) — PRIORITY source (pro plan):
# listing, analyst, short interest + quote/price backup. Bearer token, "769|xxxx".
MBOUM_API_KEY=
# Optional: stand-down after Mboum's MONTHLY quota trips (re-probe cadence).
MBOUM_RATE_LIMIT_COOLDOWN_SECONDS=3600

# Alpha Vantage (https://www.alphavantage.co) — technicals, news sentiment, macro
ALPHAVANTAGE_API_KEY=

# Twelve Data (https://twelvedata.com) — COMPLEMENTARY paid feed: batch quote
# prefetch for the intraday radar, quote/price fallback, technicals enrichment.
TWELVEDATA_API_KEY=
# Optional: keep at/below your TwelveData dashboard request/sec limit.
TWELVEDATA_MAX_PER_SEC=8
# Optional: costs 100 TwelveData credits/request; default config leaves this off.
TWELVEDATA_ENABLE_MARKET_MOVERS=false

# --- Optional web research (pro-source scores: Zacks / Morningstar / Danelfin / TipRanks) ---
# Exa search (https://exa.ai). If absent, web-research factor is skipped (not faked).
EXA_API_KEY=
# Firecrawl search/scrape for source-scoped pro-score parsing.
FIRECRAWL_API_KEY=
# Optional: generic web-news sentiment is noisy and disabled by default.
WEB_RESEARCH_ENABLE_NEWS_SENTIMENT=false

# --- AI analyst (the 6th, LLM-in-the-loop voice — Claude) ---
# Anthropic API key. If absent, the AI overlay no-ops and the agent runs pure-quant.
ANTHROPIC_API_KEY=

# --- Robinhood Agentic Trading MCP ---
# Endpoint is fixed by Robinhood. Auth is OAuth: run `rh-agent auth` once, or set a token.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN=
ROBINHOOD_MCP_TOKEN_FILE=

# --- Execution (REAL MONEY — Robinhood Agentic account) ---
# live   = place REAL orders in your Robinhood *Agentic* account
# paper  = simulate fills on live prices only (non-production testing)
EXECUTION_MODE=live
# Required exact string to arm live order placement:
LIVE_TRADING_CONFIRM=I_UNDERSTAND_REAL_MONEY
